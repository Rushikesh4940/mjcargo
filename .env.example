# Where quote requests are POSTed as JSON (Formspree, Web3Forms, Getform or your own handler).
# Example: https://formspree.io/f/xxxxxxxx — leave empty to keep online submission switched off.
VITE_QUOTE_ENDPOINT=

# Production origin, used for canonical URLs, og:image and sitemap.xml (no trailing slash).
# On Vercel this falls back to the project's production domain automatically.
SITE_URL=
